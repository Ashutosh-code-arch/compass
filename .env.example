# Copy to .env. Never commit .env.

DATABASE_URL=postgres://compass:compass@localhost:5432/compass

# A fine-grained personal access token with read-only access to PUBLIC repositories and no
# account permissions is sufficient — the corpus only ever reads public data. Do not grant repo
# write, workflow, or organisation scopes; nothing here needs them.
GITHUB_TOKEN=

# Stop a run rather than spend the last of the hourly quota. Watermarks make aborts resumable,
# so a conservative floor costs nothing.
GITHUB_MIN_REMAINING=300

# In-flight requests. GitHub asks for modest concurrency from a single token.
SYNC_CONCURRENCY=3

# Courtesy floor between request starts, in ms. Guards the undocumented secondary limits.
SYNC_MIN_INTERVAL_MS=120
